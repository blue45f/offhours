{
  "name": "offhours",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm shared:build && pnpm -r --parallel --stream --if-present run dev",
    "dev:web": "pnpm --filter @offhours/web dev",
    "dev:api": "pnpm --filter @offhours/api dev",
    "dev:shared": "pnpm --filter @offhours/shared dev",
    "build": "pnpm exec turbo run build",
    "clean": "pnpm -r --if-present run clean",
    "typecheck": "pnpm exec turbo run typecheck",
    "lint": "eslint . && pnpm exec turbo run lint",
    "test": "pnpm exec turbo run test --concurrency=1",
    "test:run": "pnpm shared:build && pnpm -r --if-present run test:run",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,html,css}\"",
    "test:api-contracts": "node --test scripts/audit-api-contracts.test.mjs",
    "test:frontend-a11y": "node --test scripts/audit-frontend-a11y.test.mjs",
    "audit:api-contracts": "node scripts/audit-api-contracts.mjs",
    "audit:frontend-a11y": "node scripts/audit-frontend-a11y.mjs",
    "db:push": "pnpm --filter @offhours/api db:push",
    "db:generate": "pnpm --filter @offhours/api db:generate",
    "db:migrate": "pnpm --filter @offhours/api db:migrate",
    "db:reset": "pnpm --filter @offhours/api db:reset",
    "seed": "pnpm --filter @offhours/api seed",
    "shared:build": "pnpm --filter @offhours/shared build",
    "shared:dev": "pnpm --filter @offhours/shared dev",
    "postinstall": "pnpm --filter @offhours/shared build",
    "ci": "pnpm run format:check && pnpm run test:api-contracts && pnpm run test:frontend-a11y && pnpm run audit:api-contracts && pnpm run audit:frontend-a11y && pnpm run lint:ci && pnpm run typecheck && pnpm run test:run && pnpm run build",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "verify": "pnpm run validate:architecture && pnpm run ci",
    "verify:push": "pnpm run verify && pnpm run lint:security",
    "sonar": "sonar-scanner",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:ci": "pnpm run lint:strict",
    "audit:security": "pnpm audit --audit-level high --ignore GHSA-2p57-rm9w-gvfp",
    "lint:security": "pnpm run lint:strict && pnpm run audit:security",
    "sonar:ci": "sonar-scanner -Dsonar.qualitygate.wait=true",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@heejun/eslint-config": "^4.0.0",
    "@heejun/prettier-config": "^3.0.0",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript-eslint": "^8.61.0"
  },
  "prettier": "@heejun/prettier-config",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  }
}
