# ─────────────────────────────────────────────────────────────
# Root environment (copy to .env and fill)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Database
DATABASE_URL="postgresql://offhours:offhours@localhost:5432/offhours?schema=public"

# API
PORT=3000
JWT_SECRET="change-me-to-a-long-random-string-32-bytes-min"
JWT_REFRESH_SECRET="change-me-too-long-random-string-32-bytes-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
APP_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# Toss Payments (테스트 키)
TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxx"
TOSS_SECRET_KEY="test_sk_xxxxxxxxxxxx"
TOSS_WEBHOOK_SECRET=""

# Storage (선택)
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Notification (Phase 2)
SES_FROM="no-reply@offhours.kr"
KAKAO_BIZ_KEY=""

# Web (Vite) — VITE_* 만 클라이언트로 노출
VITE_API_URL="http://localhost:3000"
VITE_TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxx"
# SurveyDesk 피드백 위젯 엔드포인트 (설정 시에만 위젯 노출, 미설정=비활성)
# 예) https://surveydesk-api.vercel.app
VITE_SURVEYDESK_URL=""

# DeskCloud 네이티브 통합 — @heejun/deskcloud SDK 의 pk_ 브라우저 클라이언트로 데이터만 받아
# offhours 자체 컴포넌트로 렌더한다(위젯 임베드 아님). 각 *_URL 설정 시에만 해당 기능 활성,
# 미설정 시 1st-party/빈 상태로 폴백(가역적·무영향). *_PK 미설정 시 pk_demo.
# sk_(시크릿) 키는 클라이언트에 넣지 말 것 — 브라우저 번들은 pk_ 만 사용한다.
# 라이브 엔드포인트는 아래 "예)" 값을 참고해 프로덕션 환경변수로 주입(소스 하드코딩 금지).
# ChangelogDesk: /whats-new 업데이트 소식 페이지 (예: https://changelogdesk-api.vercel.app)
VITE_CHANGELOGDESK_URL=""
VITE_CHANGELOGDESK_PK=""
# ReviewDesk: 서비스 전반 후기 벽(About 페이지) (예: https://reviewdesk-api.vercel.app)
VITE_REVIEWDESK_URL=""
VITE_REVIEWDESK_PK=""
# CommunityDesk: /community 커뮤니티 게시판 (예: https://communitydesk-api.vercel.app)
VITE_COMMUNITYDESK_URL=""
VITE_COMMUNITYDESK_PK=""
# ModerationDesk: 공간 상세 네이티브 신고 버튼 (예: https://16.176.210.195.nip.io/moderation)
VITE_MODERATIONDESK_URL=""
VITE_MODERATIONDESK_PK=""
