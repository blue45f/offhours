# ─────────────────────────────────────────────────────────────
# Root environment (copy to .env and fill)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Database
DATABASE_URL="postgresql://offhours:offhours@localhost:5432/offhours?schema=public"

# API
PORT=3000
JWT_SECRET="change-me-to-a-long-random-string-32-bytes-min"
JWT_REFRESH_SECRET="change-me-too-long-random-string-32-bytes-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
APP_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# Toss Payments (테스트 키)
TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxx"
TOSS_SECRET_KEY="test_sk_xxxxxxxxxxxx"
TOSS_WEBHOOK_SECRET=""

# Storage (선택)
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Notification (Phase 2)
SES_FROM="no-reply@offhours.kr"
KAKAO_BIZ_KEY=""

# Web (Vite) — VITE_* 만 클라이언트로 노출
VITE_API_URL="http://localhost:3000"
VITE_TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxx"
# SurveyDesk 피드백 위젯 엔드포인트 (설정 시에만 위젯 노출, 미설정=비활성)
VITE_SURVEYDESK_URL=""

# DeskCloud 위젯 — 각 *_URL 설정 시에만 해당 위젯 노출(미설정=비활성). *_PK 미설정 시 pk_demo.
# ChangelogDesk: 변경 이력 벨 런처
VITE_CHANGELOGDESK_URL=""
VITE_CHANGELOGDESK_PK=""
# NotifyDesk: 알림 인박스 벨 (로그인 사용자 한정)
VITE_NOTIFYDESK_URL=""
VITE_NOTIFYDESK_PK=""
# SearchDesk: ⌘/ 검색 팔레트 (기존 ⌘K CommandPalette 와 비충돌)
VITE_SEARCHDESK_URL=""
VITE_SEARCHDESK_PK=""
# ReviewDesk: 후기 벽 + 작성 (플로팅 런처)
VITE_REVIEWDESK_URL=""
VITE_REVIEWDESK_PK=""
# ChatDesk: 채팅 위젯 (로그인 사용자 한정, 자체 플로팅 런처)
VITE_CHATDESK_URL=""
VITE_CHATDESK_PK=""
# MediaDesk: 업로더 + 갤러리 (플로팅 런처)
VITE_MEDIADESK_URL=""
VITE_MEDIADESK_PK=""
# CommunityDesk: 커뮤니티 게시판 (플로팅 런처)
VITE_COMMUNITYDESK_URL=""
VITE_COMMUNITYDESK_PK=""
